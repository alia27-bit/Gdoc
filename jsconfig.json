{
  "compilerOptions": {
    "checkJs": false,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2020",
    "baseUrl": ".",
    "paths": {
      "@/*": ["resources/js/*"]
    }
  },
  "include": ["resources/js/**/*.js", "vite.config.js"],
  "exclude": ["node_modules", "vendor", "Gdoc", "websocket-server/node_modules"]
}
